{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Author": "Hiro",
  "CodePath": "index.html",
  "Description": "HiroCrosshair Control for Stream Deck",
  "Icon": "images/pluginIcon",
  "Name": "HiroCrosshair",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "6.9"
  },
  "UUID": "com.hiro.crosshair",
  "Version": "1.0",
  "Actions": [
    {
      "Icon": "images/actionIcon",
      "Name": "Toggle Overlay",
      "UUID": "com.hiro.crosshair.toggle",
      "Tooltip": "Show or hide the crosshair",
      "States": [
        {
          "Image": "images/actionState0",
          "Title": "Toggle",
          "TitleAlignment": "bottom",
          "FontSize": 10
        }
      ]
    },
    {
      "Icon": "images/actionIcon",
      "Name": "Select Game",
      "UUID": "com.hiro.crosshair.select",
      "Tooltip": "Select a game profile",
      "PropertyInspectorPath": "pi.html",
      "States": [
        {
          "Image": "images/actionState1",
          "Title": "Select",
          "TitleAlignment": "bottom",
          "FontSize": 10
        }
      ]
    }
  ]
}